PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/dhrms
JWT_SECRET=replace-with-existing-jwt-secret
JWT_EXPIRATION=86400000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Firebase Admin SDK: use a service account with access only to this private bucket.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
# Preserve line breaks as \n when setting this environment variable.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
IMAGE_MAX_SIZE_MB=10
PDF_MAX_SIZE_MB=20
