// Prisma schema for DHRMS NestJS backend
// Generated/maintained for the PostgreSQL migration backend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  REGISTRATION_OFFICER
  HOSPITAL_ADMIN
  DOCTOR
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DoctorRole {
  DOCTOR
  READ_ONLY
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
}

enum EncounterStatus {
  ACTIVE
  COMPLETED
}

enum AttachmentStatus {
  ACTIVE
  REVOKED
}

model User {
  id BigInt @id @default(autoincrement())
  email String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  role UserRole
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  doctor Doctor?
  worker Worker?
  registrationOfficer RegistrationOfficer?
  hospitalAdmin HospitalAdmin?
  @@map("users")
}

model RegistrationOfficer {
  id BigInt @id @default(autoincrement())
  userId BigInt @unique @map("user_id")
  fullName String @map("full_name") @db.VarChar(255)
  user User @relation(fields: [userId], references: [id])
  @@map("registration_officers")
}

model Hospital {
  id BigInt @id @default(autoincrement())
  name String @db.VarChar(255)
  code String @unique @db.VarChar(100)
  address String? @db.VarChar(500)
  district String? @db.VarChar(100)
  phone String? @db.VarChar(50)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  admins HospitalAdmin[]
  doctors Doctor[]
  assignments DoctorWorkerAssignment[]
  medicalRecords MedicalRecord[]
  encounters Encounter[]
  @@map("hospitals")
}

model HospitalAdmin {
  id BigInt @id @default(autoincrement())
  userId BigInt @unique @map("user_id")
  hospitalId BigInt @map("hospital_id")
  fullName String @map("full_name") @db.VarChar(255)
  user User @relation(fields: [userId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  @@index([hospitalId])
  @@map("hospital_admins")
}

model Doctor {
  id BigInt @id @default(autoincrement())
  userId BigInt @unique @map("user_id")
  hospitalId BigInt @map("hospital_id")
  fullName String @map("full_name") @db.VarChar(255)
  licenseNumber String? @map("license_number") @db.VarChar(100)
  specialization String? @db.VarChar(255)
  department String? @db.VarChar(255)
  role DoctorRole @default(DOCTOR)
  status DoctorStatus @default(ACTIVE)
  workingHours Json? @map("working_hours")
  user User @relation(fields: [userId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  assignments DoctorWorkerAssignment[]
  medicalRecords MedicalRecord[]
  encounters Encounter[]
  prescriptions Prescription[]
  @@index([hospitalId])
  @@map("doctors")
}

model Worker {
  id BigInt @id @default(autoincrement())
  userId BigInt? @unique @map("user_id")
  workerCode String @unique @map("worker_code") @db.VarChar(100)
  fullName String @map("full_name") @db.VarChar(255)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender Gender?
  bloodGroup String? @map("blood_group") @db.VarChar(20)
  phone String? @db.VarChar(50)
  address String? @db.VarChar(500)
  emergencyContactName String? @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactPhone String? @map("emergency_contact_phone") @db.VarChar(50)
  emergencyContactRelation String? @map("emergency_contact_relation") @db.VarChar(100)
  employerName String? @map("employer_name") @db.VarChar(255)
  worksiteName String? @map("worksite_name") @db.VarChar(255)
  worksiteAddress String? @map("worksite_address") @db.VarChar(500)
  worksiteDistrict String? @map("worksite_district") @db.VarChar(100)
  jobRole String? @map("job_role") @db.VarChar(255)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User? @relation(fields: [userId], references: [id])
  qrCodes WorkerQrCode[]
  assignments DoctorWorkerAssignment[]
  medicalRecords MedicalRecord[]
  prescriptions Prescription[]
  encounters Encounter[]
  @@index([phone])
  @@map("workers")
}

model WorkerQrCode {
  id BigInt @id @default(autoincrement())
  workerId BigInt @map("worker_id")
  code String @unique @db.VarChar(255)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  worker Worker @relation(fields: [workerId], references: [id])
  @@index([workerId])
  @@map("worker_qr_codes")
}

model Encounter {
  id BigInt @id @default(autoincrement())
  workerId BigInt @map("worker_id")
  hospitalId BigInt @map("hospital_id")
  doctorId BigInt @map("doctor_id")
  status EncounterStatus @default(ACTIVE)
  startedAt DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  worker Worker @relation(fields: [workerId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])
  medicalRecords MedicalRecord[]
  @@index([workerId, status], map: "idx_encounter_worker_status")
  @@index([hospitalId, status], map: "idx_encounter_hospital_status")
  @@index([doctorId, status], map: "idx_encounter_doctor_status")
  @@index([startedAt], map: "idx_encounter_started_at")
  @@map("encounters")
}

model DoctorWorkerAssignment {
  id BigInt @id @default(autoincrement())
  doctorId BigInt @map("doctor_id")
  workerId BigInt @map("worker_id")
  hospitalId BigInt @map("hospital_id")
  assignedBy BigInt? @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")
  endedAt DateTime? @map("ended_at")
  active Boolean @default(true)
  doctor Doctor @relation(fields: [doctorId], references: [id])
  worker Worker @relation(fields: [workerId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  @@index([doctorId], map: "idx_assignment_doctor")
  @@index([workerId], map: "idx_assignment_worker")
  @@index([hospitalId], map: "idx_assignment_hospital")
  @@index([doctorId, workerId, hospitalId], map: "idx_assignment_doctor_worker_hospital")
  @@map("doctor_worker_assignments")
}

model MedicalRecord {
  id BigInt @id @default(autoincrement())
  workerId BigInt @map("worker_id")
  hospitalId BigInt @map("hospital_id")
  doctorId BigInt @map("doctor_id")
  encounterId BigInt? @unique @map("encounter_id")
  visitDate DateTime @map("visit_date") @db.Date
  symptoms String? @db.VarChar(2000)
  diagnosis String @db.VarChar(2000)
  treatment String? @db.VarChar(3000)
  notes String? @db.VarChar(5000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  worker Worker @relation(fields: [workerId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])
  prescriptions Prescription[]
  attachments MedicalRecordAttachment[]
  @@index([workerId], map: "idx_medical_record_worker")
  @@index([doctorId], map: "idx_medical_record_doctor")
  @@index([hospitalId], map: "idx_medical_record_hospital")
  @@index([encounterId], map: "idx_medical_record_encounter")
  @@index([visitDate], map: "idx_medical_record_visit_date")
  @@map("medical_records")
}

model Prescription {
  id BigInt @id @default(autoincrement())
  medicalRecordId BigInt @map("medical_record_id")
  workerId BigInt @map("worker_id")
  doctorId BigInt @map("doctor_id")
  medicineName String @map("medicine_name") @db.VarChar(200)
  dosage String? @db.VarChar(100)
  frequency String? @db.VarChar(100)
  duration String? @db.VarChar(100)
  instructions String? @db.VarChar(1000)
  filePath String? @map("file_path") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  worker Worker @relation(fields: [workerId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])
  @@index([medicalRecordId], map: "idx_prescription_record")
  @@index([workerId], map: "idx_prescription_worker")
  @@map("prescriptions")
}

model MedicalRecordAttachment {
  id BigInt @id @default(autoincrement())
  medicalRecordId BigInt @map("medical_record_id")
  workerId BigInt @map("worker_id")
  doctorId BigInt @map("doctor_id")
  fileName String @map("file_name") @db.VarChar(255)
  storagePath String @map("storage_path") @db.VarChar(500)
  mimeType String @map("mime_type") @db.VarChar(100)
  fileSize Int @map("file_size")
  status AttachmentStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  worker Worker @relation(fields: [workerId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])
  @@index([medicalRecordId], map: "idx_medical_record_attachment_record")
  @@index([workerId], map: "idx_medical_record_attachment_worker")
  @@map("medical_record_attachments")
}
