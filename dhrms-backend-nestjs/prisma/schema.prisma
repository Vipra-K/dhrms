generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @db.VarChar(30)
  status       String    @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  hospital     Hospital?
  doctor       Doctor?
  worker       Worker?

  @@map("users")
}

model HfrFacility {
  id        BigInt     @id @default(autoincrement())
  hfrId     String     @unique @map("hfr_id") @db.VarChar(100)
  name      String     @db.VarChar(255)
  status    String     @default("ACTIVE") @db.VarChar(20)
  hospitals Hospital[]

  @@map("hfr_facilities")
}

model Hospital {
  id             BigInt                   @id @default(autoincrement())
  userId         BigInt                   @unique @map("user_id")
  hfrFacilityId  BigInt                   @map("hfr_facility_id")
  hospitalCode   String                   @map("hospital_code") @db.VarChar(50)
  name           String                   @db.VarChar(255)
  address        String?                  @db.VarChar(300)
  city           String?                  @db.VarChar(100)
  district       String?                  @db.VarChar(100)
  phone          String?                  @db.VarChar(20)
  status         String                   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  user           User                     @relation(fields: [userId], references: [id])
  hfrFacility    HfrFacility              @relation(fields: [hfrFacilityId], references: [id])
  doctors        Doctor[]
  assignments    DoctorWorkerAssignment[]
  medicalRecords MedicalRecord[]

  @@index([hospitalCode], map: "idx_hospital_code")
  @@index([hfrFacilityId], map: "idx_hospital_hfr_id")
  @@map("hospitals")
}

model Doctor {
  id                BigInt                   @id @default(autoincrement())
  userId            BigInt                   @unique @map("user_id")
  hospitalId        BigInt                   @map("hospital_id")
  fullName          String                   @map("full_name") @db.VarChar(200)
  specialization    String?                  @db.VarChar(150)
  licenseNumber     String?                  @unique @map("license_number") @db.VarChar(100)
  department        String?                  @db.VarChar(100)
  role              String                   @default("JUNIOR_DOCTOR") @db.VarChar(30)
  status            String                   @default("ACTIVE") @db.VarChar(20)
  workingHoursStart String?                  @map("working_hours_start") @db.VarChar(10)
  workingHoursEnd   String?                  @map("working_hours_end") @db.VarChar(10)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  user              User                     @relation(fields: [userId], references: [id])
  hospital          Hospital                 @relation(fields: [hospitalId], references: [id])
  assignments       DoctorWorkerAssignment[]
  medicalRecords    MedicalRecord[]
  prescriptions     Prescription[]

  @@index([licenseNumber], map: "idx_doctor_license")
  @@index([hospitalId], map: "idx_doctor_hospital")
  @@map("doctors")
}

model Worker {
  id                       BigInt                   @id @default(autoincrement())
  userId                   BigInt?                  @unique @map("user_id")
  workerCode               String                   @unique @map("worker_code") @db.VarChar(50)
  fullName                 String                   @map("full_name") @db.VarChar(200)
  dateOfBirth              DateTime?                @map("date_of_birth") @db.Date
  gender                   String?                  @db.VarChar(20)
  bloodGroup               String?                  @map("blood_group") @db.VarChar(10)
  phone                    String?                  @db.VarChar(20)
  address                  String?                  @db.VarChar(300)
  emergencyContactName     String?                  @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone    String?                  @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactRelation String?                  @map("emergency_contact_relation") @db.VarChar(50)
  active                   Boolean                  @default(true)
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  user                     User?                    @relation(fields: [userId], references: [id])
  qrCode                   WorkerQrCode?
  assignments              DoctorWorkerAssignment[]
  medicalRecords           MedicalRecord[]
  prescriptions            Prescription[]

  @@index([workerCode], map: "idx_worker_code")
  @@index([fullName], map: "idx_worker_name")
  @@map("workers")
}

model DoctorWorkerAssignment {
  id         BigInt   @id @default(autoincrement())
  doctorId   BigInt   @map("doctor_id")
  workerId   BigInt   @map("worker_id")
  hospitalId BigInt   @map("hospital_id")
  assignedBy BigInt?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")
  active     Boolean  @default(true)
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  worker     Worker   @relation(fields: [workerId], references: [id])
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@unique([doctorId, workerId, hospitalId], map: "uk_doctor_worker_hospital")
  @@index([doctorId], map: "idx_assignment_doctor")
  @@index([workerId], map: "idx_assignment_worker")
  @@index([hospitalId], map: "idx_assignment_hospital")
  @@map("doctor_worker_assignments")
}

model MedicalRecord {
  id            BigInt         @id @default(autoincrement())
  workerId      BigInt         @map("worker_id")
  hospitalId    BigInt         @map("hospital_id")
  doctorId      BigInt         @map("doctor_id")
  visitDate     DateTime       @map("visit_date") @db.Date
  symptoms      String?        @db.VarChar(2000)
  diagnosis     String         @db.VarChar(2000)
  treatment     String?        @db.VarChar(3000)
  notes         String?        @db.VarChar(5000)
  createdAt     DateTime       @default(now()) @map("created_at")
  worker        Worker         @relation(fields: [workerId], references: [id])
  hospital      Hospital       @relation(fields: [hospitalId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]

  @@index([workerId], map: "idx_medical_record_worker")
  @@index([doctorId], map: "idx_medical_record_doctor")
  @@index([hospitalId], map: "idx_medical_record_hospital")
  @@index([visitDate], map: "idx_medical_record_visit_date")
  @@map("medical_records")
}

model Prescription {
  id              BigInt        @id @default(autoincrement())
  medicalRecordId BigInt        @map("medical_record_id")
  workerId        BigInt        @map("worker_id")
  doctorId        BigInt        @map("doctor_id")
  medicineName    String        @map("medicine_name") @db.VarChar(200)
  dosage          String?       @db.VarChar(100)
  frequency       String?       @db.VarChar(100)
  duration        String?       @db.VarChar(100)
  instructions    String?       @db.VarChar(1000)
  filePath        String?       @map("file_path") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at")
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  worker          Worker        @relation(fields: [workerId], references: [id])
  doctor          Doctor        @relation(fields: [doctorId], references: [id])

  @@index([medicalRecordId], map: "idx_prescription_record")
  @@index([workerId], map: "idx_prescription_worker")
  @@map("prescriptions")
}

model WorkerQrCode {
  id        BigInt    @id @default(autoincrement())
  workerId  BigInt    @unique @map("worker_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  status    String    @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  worker    Worker    @relation(fields: [workerId], references: [id])

  @@map("worker_qr_codes")
}
